# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*

# Captured OBD session logs (may contain your VIN) — keep the files local but
# preserve the folder via captures/.gitkeep.
captures/*
!captures/.gitkeep
*.obdlog

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Env — ignore local/secret env files, but DO track the committed dev defaults
# in packages/web/.env (no secrets there; it just points the UI at the bridge).
.env.local
.env.*.local
!.env

# OpenMVCI local build
openmvci/build/

