{
  "name": "@pradoobd/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "capture": "tsx src/capture.ts",
    "capture:mock": "cross-env MOCK=1 tsx src/capture.ts",
    "watch": "tsx src/watch.ts",
    "watch:mock": "cross-env MOCK=1 tsx src/watch.ts",
    "safe-read": "cross-env READ_ONLY=1 tsx src/watch.ts",
    "safe-read:mock": "cross-env READ_ONLY=1 MOCK=1 tsx src/watch.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pradoobd/shared": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "optionalDependencies": {
    "serialport": "^13.0.0"
  }
}
